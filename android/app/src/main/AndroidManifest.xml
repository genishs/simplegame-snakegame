<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fruit-eat / game-over haptics via the Android.vibrate() JS bridge. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Older builds locked the activity to portrait, which made Play infer
         screen.portrait as a *required* feature. The lock is gone (#41), but keeping
         the optional declaration is harmless and keeps the device filter off. (#36) -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnakeGame">
        <!-- configChanges: the whole game lives in one WebView page, so recreating the
             activity reloads it and loses the run in progress. Handle every change a
             resize can bring (rotation, fold/unfold, multi-window and freeform resize,
             display size/density) plus keyboard attach and night mode in place; the
             page re-lays itself out on its own resize event. (#24)
             No screenOrientation / resizeableActivity restriction (#41): Android 16
             ignores them on 600dp+ screens anyway, and Play flags them as a large-screen
             issue. The page has portrait, landscape and touch-landscape layouts. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.SnakeGame.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
